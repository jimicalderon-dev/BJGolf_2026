# BJ Golf 2026 — local environment variables (example)
#
# Copy this file to `.env` and fill in values.
# Never commit `.env` (it should be gitignored).
#
# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
#
# GolfCourseAPI — set as a Supabase secret for Edge Functions.
# supabase secrets set GOLF_COURSE_API_KEY=your_key_here
VITE_GOLF_COURSE_API_KEY=

